# Local development placeholders only. Never put real credentials in this file.
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret-key
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Optional SMTP delivery: switch the backend only after configuring your service.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.invalid

# These flags are read by config.settings when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated HTTPS origins; defaults to the allowed hosts.
CSRF_TRUSTED_ORIGINS=
# Container deployment only: supply a strong private database password.
DB_PASSWORD=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ENABLE_HSTS=False

# Optional browser maps and server-side Places integrations.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_BROWSER_MAPS_API_KEY=

# Optional social sign-in; leave blank until deliberately configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional production integrations remain disabled.
REDIS_URL=
SENTRY_DSN=

# Catalogue jobs are opt-in. Set an identifying product user-agent and contact
# before enabling the public Overpass source. Never put provider keys in Git.
CATALOG_SYNC_ENABLED=false
CATALOG_USER_AGENT=
